{
  "name": "pi-cmux-presence",
  "version": "0.1.0",
  "description": "Socket-only cmux presence observer for Pi",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "files": ["index.ts", "src/**/*", "docs/**/*.md", "docs/diagram/**/*", "AGENTS.md", "README.md", "LICENSE"],
  "keywords": ["pi-package", "cmux", "presence"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "check": "bunx tsc --noEmit",
    "ci": "bun run check && bun run test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
