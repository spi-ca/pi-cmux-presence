%% Diagram source: docs/diagram/socket-resolution.mmd
flowchart TB
  classDef core stroke-width:3px
  classDef boundary stroke-dasharray: 4 3
  classDef cmux stroke-width:3px,stroke-dasharray: 2 2

  subgraph Identity[identity.ts: identity]
    direction LR
    Env[CMUX_WORKSPACE_ID /<br/>CMUX_SURFACE_ID] --> UUIDCheck{Both present and<br/>RFC variant UUID v1-v5?}
    UUIDCheck -->|no| NoIdentity[No identity:<br/>skip client creation]
    UUIDCheck -->|yes| CmuxIdentity[CmuxIdentity]
  end

  subgraph Socket[identity.ts: socket path]
    direction LR
    Configured[CMUX_SOCKET_PATH<br/>trimmed] -->|set| Candidate1[Configured<br/>candidate only]
    Configured -->|unset| Candidate2[Stable candidate:<br/>~/.local/state/cmux/cmux.sock]
    Candidate1 --> Fingerprint
    Candidate2 --> Fingerprint
    Fingerprint[safeSocketFingerprint:<br/>absolute path, owner-only socket,<br/>lexical + resolved ancestor chain] -->|throws| NoSocket[No socket:<br/>skip client creation]
    Fingerprint -->|ok| ValidSocket[Validated socket path<br/>+ dev/ino/uid fingerprint]
  end

  subgraph Startup[Runtime startup path resolution]
    direction LR
    StartEpoch[Session epoch starts] --> Exclusive{Older resolver<br/>still unresolved?}
    Exclusive -->|yes| SkipResolver[Skip this epoch's resolver;<br/>never reuse stale result]
    Exclusive -->|no| Resolve[Resolve configured/stable path]
    Resolve --> Deadline{Deadline or epoch<br/>abort first?}
    Deadline -->|yes| Stale[Abandon result; keep one<br/>resolver exclusive until settle]
    Deadline -->|no| ValidSocket
    Stale --> Settles[Stale resolver settles;<br/>future epoch may retry]
  end

  CmuxIdentity --> Gate
  ValidSocket --> Gate
  Gate{Identity and socket<br/>both resolved?}
  Gate -->|no| Disabled[cmux client/output disabled;<br/>process-local observer may continue]
  Gate -->|yes| ClientCreate[Create PresenceClient +<br/>UnixSocketTransport]

  subgraph TransportValidation[Runtime transport validation]
    direction LR
    ClientCreate --> SharedGate[One runtime-owned fingerprint lease gate:<br/>transport calls intrinsic<br/>safeSocketFingerprint directly]
    SharedGate --> Revalidate[Before and after connect:<br/>compare dev/ino/uid]
    Revalidate -->|data/end/close/error while a<br/>post-connect fingerprint is pending| FailClose[Reject response + fail-close queue;<br/>retain stale lease until settle]
    FailClose --> Replacement[Session replacement refuses new<br/>validation until stale lease settles]
    Revalidate -->|both fingerprints match<br/>then request write| Exchange[Accept one bounded response]
  end

  subgraph Hook[official-hook.ts: precedence]
    direction LR
    HookEnv{CMUX_PI_HOOKS_DISABLED<br/>== 1?}
    HookEnv -->|yes| HookOff[Official hook<br/>detection skipped]
    HookEnv -->|no| HookDir[PI_CODING_AGENT_DIR<br/>or ~/.pi/agent]
    HookDir --> HookRead[Read extensions/<br/>cmux-session.ts]
    HookRead -->|marker v2 found| HookDetected[Official hook detected]
    HookRead -->|missing/unreadable| HookAbsent[No official hook]
  end

  HookDetected --> Precedence[Suppress native lifecycle,<br/>feed, meta, auto-title,<br/>resume fallback, local completion,<br/>and pi-subagent success native alert;<br/>external attention + pi-subagent error eligible]
  HookAbsent --> OptIn[PresenceConfig opt-in flags<br/>gate each remaining feature]
  HookOff --> OptIn

  class CmuxIdentity,ValidSocket,ClientCreate,SharedGate,Exchange core
  class Env,Configured,Candidate1,Candidate2,Fingerprint,StartEpoch,Exclusive,Resolve,Deadline,Revalidate,HookDir,HookRead,HookEnv boundary
  class NoIdentity,NoSocket,SkipResolver,Stale,Settles,Disabled,FailClose,Replacement,HookOff,HookDetected,HookAbsent,Precedence,OptIn boundary
